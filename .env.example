# Copy to .env (never commit .env) or set these in Render → Environment.
# Without DATABASE_URL the app uses a local SQLite file (instance/umbral_system.db) for development.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SECRET_KEY=<64 random hex characters: python -c "import secrets; print(secrets.token_hex(32))">
ADMIN_USERNAME=<first administrator user name>
ADMIN_PASSWORD=<a long password, 8+ characters with letters and numbers>
